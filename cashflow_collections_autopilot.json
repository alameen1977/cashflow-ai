              "id": "d6",
              "name": "cash_at_risk_pct",
              "value": "={{ Math.round(1000 * $('Get Risk-Ranked Open Invoices').item.json.total_cash_at_risk / $('Get Risk-Ranked Open Invoices').item.json.total_open_amount) / 10 }}",
