    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short payment reminder email (max 120 words) from the Accounts Receivable team of \"CashFlow AI Demo Co.\" to a customer.\nInvoice number: {{ $json.invoice_number }}\nAmount: AED {{ $json.amount }}\nDue date: {{ $json.due_date }} (days until due: {{ $json.days_to_due }}; negative means overdue)\nRisk tier: {{ $json.risk_tier }}\nInvoice disputed: {{ $json.disputed }}\nTone rules:\n- MEDIUM risk: warm, friendly reminder before the due date.\n- HIGH risk: polite but firm; ask the customer to confirm the payment date by reply, and say their account manager will call.\n- If the invoice is disputed: do NOT demand payment; acknowledge the query and offer a call to resolve it quickly.\n- Never threaten, never mention AI, risk scores or internal predictions.\nSign off as \"Accounts Receivable Team, CashFlow AI Demo Co.\"",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 5,
          "delayBetweenBatches": 500
        }
      },
      "id": "f4e78d4f-60fa-496a-bfdd-b10d8fb17fa2",
