              "id": "d10",
              "name": "forecast_next_4_weeks",
              "value": "={{ Math.round($json.weeks.reduce((s, w) => s + w.forecast_ai, 0) * 100) / 100 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
